-- ============================================================
--  AutoReq — Script de criação do banco de dados
--  Banco: autoreq | Charset: utf8mb4
-- ============================================================

CREATE DATABASE IF NOT EXISTS autoreq
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE autoreq;

-- ────────────────────────────────────────────────────────────
--  1. USUARIOS
-- ────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS usuarios (
    id            INT UNSIGNED     NOT NULL AUTO_INCREMENT,
    nome          VARCHAR(150)     NOT NULL,
    email         VARCHAR(255)     NOT NULL,
    senha         VARCHAR(255)     NOT NULL,          -- bcrypt hash
    papel         ENUM('admin','analista','gerente')
                                   NOT NULL DEFAULT 'analista',
    ultimo_acesso DATETIME             NULL DEFAULT NULL,
    criado_em     DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    UNIQUE KEY uq_usuarios_email (email)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ────────────────────────────────────────────────────────────
--  2. PROJETOS
-- ────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS projetos (
    id            INT UNSIGNED     NOT NULL AUTO_INCREMENT,
    nome          VARCHAR(255)     NOT NULL,
    cliente       VARCHAR(255)         NULL DEFAULT NULL,
    status        ENUM('Planejamento','Em andamento','Concluído','Cancelado')
                                   NOT NULL DEFAULT 'Planejamento',
    descricao     TEXT                 NULL DEFAULT NULL,
    usuario_id    INT UNSIGNED     NOT NULL,
    data_criacao  DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    KEY idx_projetos_usuario (usuario_id),
    CONSTRAINT fk_projetos_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ────────────────────────────────────────────────────────────
--  3. REQUISITOS
-- ────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS requisitos (
    id            INT UNSIGNED     NOT NULL AUTO_INCREMENT,
    codigo        VARCHAR(50)          NULL DEFAULT NULL,   -- ex.: RF-001
    tipo          ENUM('RF','RNF','RN')
                                   NOT NULL DEFAULT 'RF',
    titulo        VARCHAR(255)     NOT NULL,
    descricao     TEXT                 NULL DEFAULT NULL,
    prioridade    ENUM('Alta','Média','Baixa')
                                   NOT NULL DEFAULT 'Média',
    status        ENUM('Pendente','Aprovado','Revisão')
                                   NOT NULL DEFAULT 'Pendente',
    justificativa TEXT                 NULL DEFAULT NULL,   -- preenchida na validação
    projeto_id    INT UNSIGNED     NOT NULL,
    usuario_id    INT UNSIGNED     NOT NULL,
    data_criacao  DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    KEY idx_requisitos_projeto  (projeto_id),
    KEY idx_requisitos_usuario  (usuario_id),
    KEY idx_requisitos_status   (status),
    CONSTRAINT fk_requisitos_projeto
        FOREIGN KEY (projeto_id) REFERENCES projetos (id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_requisitos_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ────────────────────────────────────────────────────────────
--  4. COMENTARIOS
-- ────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS comentarios (
    id            INT UNSIGNED     NOT NULL AUTO_INCREMENT,
    requisito_id  INT UNSIGNED     NOT NULL,
    autor         VARCHAR(150)     NOT NULL DEFAULT 'Usuário',
    texto         TEXT             NOT NULL,
    criado_em     DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    KEY idx_comentarios_requisito (requisito_id),
    CONSTRAINT fk_comentarios_requisito
        FOREIGN KEY (requisito_id) REFERENCES requisitos (id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ────────────────────────────────────────────────────────────
--  5. DIAGRAMS_EXTERNOS
-- ────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS diagrams_externos (
    id                INT UNSIGNED     NOT NULL AUTO_INCREMENT,
    usuario_id        INT UNSIGNED     NOT NULL,
    projeto_id        INT UNSIGNED         NULL DEFAULT NULL,
    tipo_diagrama     ENUM('caso_uso','classe','sequencia','geral')
                                       NOT NULL DEFAULT 'geral',
    arquivo_original  VARCHAR(255)     NOT NULL,   -- nome original enviado pelo usuário
    arquivo_servidor  VARCHAR(255)     NOT NULL,   -- nome único gerado no servidor
    tamanho_bytes     INT UNSIGNED     NOT NULL DEFAULT 0,
    criado_em         DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    UNIQUE KEY uq_diagrams_arquivo_servidor (arquivo_servidor),
    KEY idx_diagrams_usuario  (usuario_id),
    KEY idx_diagrams_projeto  (projeto_id),
    CONSTRAINT fk_diagrams_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_diagrams_projeto
        FOREIGN KEY (projeto_id) REFERENCES projetos (id)
        ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

